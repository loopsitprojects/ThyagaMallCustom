# Define DirectoryIndex so LiteSpeed/Apache will look for index.php first
DirectoryIndex index.php index.html public/index.html public/index.php

# Automatically route all incoming requests into Laravel's public/ directory.
# Nothing outside public/ (app, config, vendor, .env, ...) is reachable from the web.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Thyaga/

    # Block access to .env and sensitive environment files
    RewriteRule ^\.env - [F,L,NC]

    # Rewrite all traffic into the public/ folder
    RewriteCond %{REQUEST_URI} !/public/ [NC]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Fallback protection if mod_rewrite is unavailable
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "(composer\.json|composer\.lock|package\.json|artisan|phpunit\.xml|\.env)">
    Order allow,deny
    Deny from all
</FilesMatch>

Options -Indexes
